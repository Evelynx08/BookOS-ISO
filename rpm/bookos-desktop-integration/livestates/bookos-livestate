#!/usr/bin/env python3
"""BookOS Live States — CLI para apps no-Python (bookos-settings, scripts).

  bookos-livestate publish <id> '<json>'    publica/actualiza (sticky: sobrevive al CLI)
  bookos-livestate remove <id>              elimina
  bookos-livestate get [id]                 imprime estados (todos o uno)
  bookos-livestate monitor                  imprime cambios en vivo (para depurar)

Ejemplo (rutina desde bookos-settings):
  bookos-livestate publish routine '{"type":"routine","name":"Work","started":"18:00","finish":"02:00","objective":"8h"}'
  bookos-livestate remove routine
"""
import json, sys
import dbus

BUS_NAME = "org.bookos.LiveStates"
OBJ_PATH = "/bookos/LiveStates"
IFACE = "org.bookos.LiveStates1"


def broker(bus):
    return dbus.Interface(bus.get_object(BUS_NAME, OBJ_PATH), IFACE)


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip()); return 1
    cmd = sys.argv[1]

    if cmd == "monitor":
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
        bus.add_signal_receiver(lambda i, p: print("~", i, p), "StateChanged", IFACE)
        bus.add_signal_receiver(lambda i: print("-", i), "StateRemoved", IFACE)
        for sid, p in broker(bus).GetStates().items():
            print("=", sid, p)
        GLib.MainLoop().run()
        return 0

    bus = dbus.SessionBus()
    if cmd == "publish" and len(sys.argv) == 4:
        json.loads(sys.argv[3])                       # valida antes de enviar
        broker(bus).Publish(sys.argv[2], sys.argv[3], True)
    elif cmd == "remove" and len(sys.argv) == 3:
        broker(bus).Remove(sys.argv[2])
    elif cmd == "get":
        states = broker(bus).GetStates()
        if len(sys.argv) == 3:
            print(states.get(sys.argv[2], ""))
        else:
            for sid, p in states.items():
                print(sid, p)
    else:
        print(__doc__.strip()); return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
