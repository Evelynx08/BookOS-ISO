[Desktop Entry]
Type=Service
Name=BookOS Acciones
Comment=Acciones rápidas de sistema (wifi, energía, no molestar, bloquear…)
Icon=preferences-system
X-KDE-ServiceTypes=Plasma/Runner
X-Plasma-API=DBus
X-Plasma-DBus-Service=org.bookos.Actions
X-Plasma-DBus-Path=/bookos/Actions
X-Plasma-DBus-Interface=org.kde.krunner1
X-KDE-PluginInfo-Name=bookos-actions
X-KDE-PluginInfo-EnabledByDefault=true
