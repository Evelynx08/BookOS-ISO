# BookOS — aplicaciones por defecto del sistema.
# Los usuarios pueden cambiarlas; esto solo define el valor inicial.
[Default Applications]
text/plain=bookos-notepad.desktop
text/markdown=bookos-notepad.desktop
application/x-shellscript=bookos-notepad.desktop
application/json=bookos-notepad.desktop
text/x-log=bookos-notepad.desktop
image/png=firefox.desktop
image/jpeg=firefox.desktop
image/webp=firefox.desktop
image/gif=firefox.desktop
image/bmp=firefox.desktop
image/svg+xml=firefox.desktop
